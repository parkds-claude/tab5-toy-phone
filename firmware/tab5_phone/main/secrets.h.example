// secrets.h.example — 복사해서 secrets.h 로 만들고 값을 채운다. secrets.h 는 git 에 올리지 않는다(.gitignore: secrets*.h*).
// 내용을 화면·로그·채팅에 붙여 넣지 않는다.
#pragma once

// 처음부터 아는 Wi-Fi (여러 개 가능). 화면에서 추가한 망은 기기에 따로 저장된다.
#define WIFI_NETWORKS { {"my-ssid", "my-password"} }

// 교환기 주소. 운영(Phase 4 부터) = 맥미니 교환기, Cloudflare 터널을 거쳐 TLS 로 붙는다 — 집과 사무실처럼 서로 다른 망에서도 통화된다.
//   wss:// 면 서버 인증서를 검증하고(인증서 묶음), ws:// 면 평문이다. 같은 Wi-Fi 의 맥북 교환기로 되돌리려면(개발·시험) 이 줄만
//   "ws://192.168.0.10:5094/ws" 꼴(맥북의 LAN 주소)로 바꿔 다시 빌드한다 — 코드는 주소의 앞머리(ws/wss)만 보고 갈린다.
#define RELAY_URL "wss://phone.example.com/ws"

// 기기 표: { "MAC", 번호, "교환기 기기 ID", "토큰" }. 토큰은 server/.env.phone 의 PHONE_TOKENS 와 같아야 한다(16자 이상).
// 번호와 ID 는 main/roster.h 의 표 그대로 적는다(1 = tab5-1, 2 = tab5-2, 3 = stackchan-2) — 다르게 적은 줄은 무시되어 그 기기가 미등록으로 뜬다.
// 기기는 이 표에서 자기 MAC 의 줄만 쓴다(MAC = 칩의 기본 MAC, esptool read_mac 과 같은 값). 셋째 줄은 스택짱 2호기다(설계서 docs/exec-plans/2026-10-08-phone-3way-design.md §3·TW-D4).
#define PHONE_DEVICES { \
    { "AA:BB:CC:DD:EE:01", 1, "tab5-1", "replace-with-token-1" }, \
    { "AA:BB:CC:DD:EE:02", 2, "tab5-2", "replace-with-token-2" }, \
    { "AA:BB:CC:DD:EE:03", 3, "stackchan-2", "replace-with-token-3" }, \
}
